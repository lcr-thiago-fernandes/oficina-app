# ==========================================
# Banco de dados
# ==========================================
DB_USER=oficina
DB_PASSWORD=changeme

# ==========================================
# JWT — a API apenas VALIDA o token; quem emite e a funcao serverless
# oficina-auth. Issuer/audience abaixo sao o contrato compartilhado com ela
# e precisam bater com k8s/configmap.yaml.
# ==========================================
JWT_SECRET=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
JWT_ISSUER=oficina-auth
JWT_AUDIENCE=oficina-api

# ==========================================
# Bootstrap do usuário admin (Plano 02)
# ==========================================
ADMIN_BOOTSTRAP_PASSWORD=AlteraMe@123

# ==========================================
# Webhook de aprovação de orçamento (Plano 06)
# ==========================================
WEBHOOK_TOKEN=troque-por-um-token-secreto-forte

# ==========================================
# Ambiente
# ==========================================
ASPNETCORE_ENVIRONMENT=Development
